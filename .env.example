# Copy this file to .env and fill in your own values. Never commit .env.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# Same version as `uv run python -c "import mlflow; print(mlflow.__version__)"`
MLFLOW_VERSION=3.17.2

# Secret for POST /reload (header X-Admin-Token). Unset = /reload is disabled.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Container limits (docker compose). The API limit must fit the champion model in memory.
API_MEMORY_LIMIT=2g
API_CPU_LIMIT=2
# Optional (these are the defaults in docker-compose.yml)
POSTGRES_MEMORY_LIMIT=512m
MLFLOW_MEMORY_LIMIT=2g
PROMETHEUS_MEMORY_LIMIT=512m
